{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "ui",
  "description": "IPC access for the React UI webview only; game webviews match nothing",
  "webviews": ["ui"],
  "permissions": [
    "core:default",
    "updater:default",
    "process:allow-restart",
    "allow-show-game",
    "allow-set-game-bounds",
    "allow-hide-games",
    "allow-reload-game",
    "allow-close-game",
    "sql:default",
    "sql:allow-load",
    "sql:allow-select",
    "sql:allow-execute"
  ]
}
